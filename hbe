-- VL Hitbox V2 | Client-side visualization and practice overlay
-- Requires an executor that supports getgenv and Drawing for the 2D ring.
-- The 3D sphere is visual-only (CanQuery/CanTouch/CanCollide = false).
local env = getgenv and getgenv() or _G
if env.VLHitboxV2 and env.VLHitboxV2.cleanup then pcall(env.VLHitboxV2.cleanup) end
if env.VLHitbox and env.VLHitbox.render then
    local old = env.VLHitbox
    for _, c in ipairs({old.render, old.added, old.removed}) do pcall(function() if c then c:Disconnect() end end) end
    for _, d in pairs(old.balls or {}) do pcall(function() if d.box then d.box:Destroy() end if d.ring then d.ring:Remove() end end) end
    env.VLHitbox = nil
end

