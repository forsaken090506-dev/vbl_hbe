local defaults = { radius=10, opacity=0.22, enabled=true, show3D=true, show2D=true, frameCap=45, profile='Default' }
local profiles = {Default=table.clone(defaults), Competitive=table.clone(defaults), Minimal=table.clone(defaults)}
profiles.Competitive.radius=7
profiles.Minimal.show3D=false
profiles.Minimal.radius=6
local settings = table.clone(defaults)
local function safeRead()
    if not (readfile and isfile and isfile(saveFile)) then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(saveFile)) end)
    if not ok or type(data)~='table' then return end
    if type(data.profiles)=='table' then
        for name, profile in pairs(data.profiles) do
            if profiles[name] and type(profile)=='table' then
                for k,v in pairs(defaults) do if type(profile[k])==type(v) then profiles[name][k]=profile[k] end end
            end
        end
    end
    if type(data.active)=='string' and profiles[data.active] then settings.profile=data.active end
    for k,v in pairs(profiles[settings.profile]) do if k~='profile' then settings[k]=v end end
end
safeRead()
local function persist()
    if not writefile then return end
    local profile = profiles[settings.profile]
    if profile then for k,v in pairs(settings) do if k~='profile' then profile[k]=v end end end
    pcall(function() writefile(saveFile, HttpService:JSONEncode({active=settings.profile, profiles=profiles})) end)
end
local function track(c) connections[#connections+1]=c return c end
